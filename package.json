{
  "name": "minimp3",
  "version": "1.0.0",
  "description": "MP3 decoder for Node.js: native bindings for minimp3, as a stream or from a buffer",
  "main": "index.js",
  "types": "index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "binding.gyp",
    "lib/minimp3.cc",
    "lib/minimp3.h",
    "lib/minimp3_ex.h",
    "lib/UPSTREAM.md",
    "prebuilds"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
    "prebuildify": "prebuildify --napi --strip --tag-libc",
    "prepublishOnly": "node scripts/check-prebuilds.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "test:types": "tsc -p test/types",
    "test:install": "node scripts/smoke-install.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johangu/node-minimp3.git"
  },
  "keywords": [
    "mp3",
    "decoder",
    "minimp3",
    "audio",
    "pcm",
    "stream"
  ],
  "author": "Johan Guttormsson <johan@jgsoft.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johangu/node-minimp3/issues"
  },
  "homepage": "https://github.com/johangu/node-minimp3#readme",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^5.15.1",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0",
    "node-gyp": "^13.1.0",
    "prebuildify": "^6.0.1",
    "typescript": "^7.0.2"
  }
}
